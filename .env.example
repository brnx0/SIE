APP_NAME="SIE Matrícula"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

MUNICIPIO=homolog
FPM_PORT=9000
# migrar no boot? Default false (prod = migrar manual no deploy)
RUN_MIGRATIONS=false
# backup (docker/postgres/backup.sh): BACKUP_DIR=/opt/backups/<municipio>  BACKUP_KEEP_DAYS=7

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Postgres compartilhado (docker-compose.db.yml): superusuario apenas para
# administracao/provisionamento — os apps NAO usam este usuario (cada municipio
# tem role/banco proprios, criados via docker/postgres/provision-municipio.sh).
# PG_SUPERUSER_PASSWORD e OBRIGATORIO para subir o banco. Defina uma senha forte
# (ex.: openssl rand -base64 24). Nao commitar o valor real (isto e so o exemplo).
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=

# Banco usado pelos containers app/worker (docker-compose.app.yml). Vazio = "db"
# (Postgres do docker-compose.db.yml na rede sie_net). Banco em OUTRA maquina:
# informe o IP/host dela (DB_HOST acima vale so fora do Docker).
DB_HOST_DOCKER=
DB_PORT_DOCKER=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Produção: definir como true (requer HTTPS ativo)
SESSION_SECURE_COOKIE=false
FORCE_HTTPS=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587

MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="seu-email@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
